# Production API base URL (Vercel frontend -> Render backend).
# Vite bakes these values into the bundle at build time, so changing them
# requires a redeploy. Both names are read by src/lib/api.ts.
VITE_API_BASE_URL=https://govjob-ai-copilot.onrender.com/api/v1
VITE_GOVJOB_API_BASE=https://govjob-ai-copilot.onrender.com/api/v1
