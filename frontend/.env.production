# Production API base URL. The Vercel rewrite in vercel.json proxies /api/*
# to the Render backend, so the app talks to a same-origin path. This keeps
# the session cookie first-party (SameSite=lax works on desktop AND mobile).
# Values are baked into the bundle at build time, so changing them requires a
# redeploy. Both names are read by src/lib/api.ts.
VITE_API_BASE_URL=/api/v1
VITE_GOVJOB_API_BASE=/api/v1
